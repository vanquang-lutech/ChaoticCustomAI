# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_IMAGE_MODEL=gpt-image-2
# Defaults for generate-image and custom-text; background removal always uses size=auto
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=medium

# --- Application ---
APP_NAME=ChaoticCustomAI
API_PREFIX=/api/v1
DEBUG=false
LOG_LEVEL=INFO
LOG_DIR=logs
# Drives the storage date folders and the log filename, so day boundaries match the
# business day rather than the container's UTC clock.
TIMEZONE=Asia/Ho_Chi_Minh

# --- Storage ---
# Layout: STORAGE_DIR/<yyyy_mm>/<yyyy_mm_dd>/<feature>/<job_id>/{input,output}/
STORAGE_DIR=storage
MAX_UPLOAD_FILES=3
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/png,image/jpeg,image/webp
# Results are returned as URLs under this prefix, served by api/v1/files.py
FILES_URL_PREFIX=/api/v1/files
# Style reference images for the custom-text feature (checked into git)
STYLE_PRESETS_DIR=assets/text-styles

# --- Task queue ---
# Redis is the Celery broker only: a queue, not a result backend or application database.
# Images, job status and token usage are all files under STORAGE_DIR. Do not set
# CELERY_RESULT_BACKEND; the API polls job.json instead.
CELERY_BROKER_URL=redis://localhost:6379/0
